import random
import time

print("=== 欢迎来到【赛博猜数字】 ===")
time.sleep(0.5)
print("系统已经生成了一个 1 到 100 之间的数字。")
print("你有 1000000 次机会猜出它。准备好了吗？\n")

# 电脑随机生成一个 1-100 的数字
secret_number = random.randint(1, 100)
attempts = 0
max_attempts = 1000000

# 开始循环
while attempts < max_attempts:
    # 把用户输入转换成整数 (int)
    guess = int(input(f"第 {attempts + 1} 次尝试，请输入你的数字: "))
    attempts += 1
    
    if guess == secret_number:
        print("\033[92m🎉 卧槽！你猜对了！你绝对有黑客的直觉！\033[0m")
        break
    elif guess < secret_number:
        print("\033[93m🔺 太小了！往大一点猜。\033[0m")
    else:
        print("\033[93m🔻 太大了！往小一点猜。\033[0m")
        
    if attempts == max_attempts:
        print(f"\n\033[94m💀 游戏结束！你的机会用光了，那个数字其实是 {secret_number}。\033[0m")
